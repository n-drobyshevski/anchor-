# Copy to .env and fill in real values. Never commit .env.
# All values below are empty or non-secret placeholders.

MODE=polling
# polling for local dev; webhook in deployment.

TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=
# 1-256 chars, charset A-Z a-z 0-9 _ - (Telegram's webhook secret rules).

ALLOWED_CHAT_ID=
PUBLIC_URL=https://<service>.up.railway.app

DATABASE_URL=
# Railway gives postgresql://; the app rewrites it to postgresql+asyncpg:// itself.

LOG_LEVEL=INFO
PORT=8080

# --- 1c/1e: LLM provider (OpenRouter), prompt assembly, cost and the daily spend cap ---
OPENROUTER_API_KEY=
LLM_MODEL=thedrummer/cydonia-24b-v4.1
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.9
LLM_DATA_COLLECTION=deny
# Verified 2026-09-22 against https://openrouter.ai/thedrummer/cydonia-24b-v4.1
# (its only provider is Parasail). Used only as a fallback: when OpenRouter
# reports usage.cost, that figure wins and these are not consulted.
LLM_PRICE_IN=0.30
LLM_PRICE_CACHED=0.15
LLM_PRICE_OUT=0.50
DAILY_USD_CAP=1.00
TZ_DEFAULT=Europe/Paris
TRANSCRIPT_TURNS=30

# --- 2a: the cheap model (background calls) and scenes ---
# Same model as LLM_MODEL today, by decision: background calls run on
# Cydonia too. Kept as its own setting with its own prices so the
# background model can be swapped with one env var (compute_cost is
# model-aware). Cydonia's provider does not support reasoning_effort,
# so there is no cheap-reasoning knob.
LLM_MODEL_CHEAP=thedrummer/cydonia-24b-v4.1
# Same model as LLM_MODEL today, so the same prices; verified 2026-09-22.
LLM_CHEAP_PRICE_IN=0.30
LLM_CHEAP_PRICE_CACHED=0.15
LLM_CHEAP_PRICE_OUT=0.50
LLM_CHEAP_MAX_TOKENS=400
LLM_CHEAP_TEMPERATURE=0.3

# --- H2: the safety model (welfare classifier, extractor, tick) ---
# These three calls emit strict JSON verdicts that decide what the bot
# writes to memory and whether the persona speaks at all. They ran on
# LLM_MODEL_CHEAP -- the same roleplay fine-tune as the persona -- until
# the hardening pass moved them here. Scene summaries stay on the cheap
# model: a summary is prose.
#
# Not gpt-5-nano, though it is cheaper: it accepts no `temperature` on
# any endpoint, and with require_parameters set for every json_schema
# call that leaves zero eligible providers. Its reasoning is also
# mandatory, which risks the 8s WELFARE_TIMEOUT_SECONDS below.
#
# Prices from https://openrouter.ai/google/gemini-2.5-flash-lite,
# checked 2026-09-22.
LLM_MODEL_SAFETY=google/gemini-2.5-flash-lite
LLM_SAFETY_PRICE_IN=0.10
LLM_SAFETY_PRICE_CACHED=0.01
LLM_SAFETY_PRICE_OUT=0.40
LLM_SAFETY_MAX_TOKENS=400
# Zero, not merely low: a classifier that answers differently on a
# re-run cannot be reasoned about.
LLM_SAFETY_TEMPERATURE=0.0
SCENE_IDLE_HOURS=6

# --- 2b: memory ---
# Caps on how many memories reach each prompt. Retrieval/dedupe
# thresholds live in app/core/memory.py, not here, on purpose.
MEMORY_PINNED_MAX=8
MEMORY_RETRIEVED_MAX=6

# --- 2c: the post-turn extractor ---
MEMORY_AUTOWRITE_MIN_CONF=0.8
# Set to false if the provider turns out to reject strict json_schema.
# The extractor validates its input either way; this only affects how
# often the model returns something parseable.
LLM_STRUCTURED_OUTPUTS=true

# --- 2e: the welfare check ---
# A `real` verdict at or above this confidence drops the persona.
WELFARE_MIN_CONF=0.6
WELFARE_TIMEOUT_SECONDS=8.0

# --- 3a: proactive outbound (phase-3 plan section 2) ---
# The global kill switch. false stops every unsolicited message at the
# first gate check, planning included.
OUTBOUND_ENABLED=true
# Wall-clock times in user_state.timezone, not UTC.
MORNING_TIME=09:00
EVENING_TIME=22:00
# How late a fixed intent may still fire after a restart. The evening
# nag's window is clamped to QUIET_START regardless.
SEND_GRACE_MIN=180
# Quiet hours, local, wrapping past midnight.
QUIET_START=22:30
QUIET_END=08:00
MAX_UNSOLICITED_PER_DAY=3
MIN_GAP_UNANSWERED_H=8
# After this many unanswered messages Anchor goes silent until you
# write -- fixed intents included.
MAX_IGNORED_IN_ROW=3
SILENCE_NUDGE_H=48
# Local hours at which the optional tick is considered. Comma list.
TICK_HOURS=10,12,14,16,18,20
TICK_MAX_PER_DAY=1
TICK_SKIP_IF_ACTIVE_H=2
# Set to 0 for manual phone testing, where predictability beats texture.
JITTER_MAX_MIN=15
# After a welfare trigger, silence and tick stay off this long. Morning
# and evening resume with the persona.
WELFARE_COOLDOWN_H=24
QUIET_MAX_DAYS=7

# --- 3e: the eval harness (phase-3 plan section 9) ---
# Which model scores the rubric. Empty = LLM_MODEL_CHEAP, which is what
# the plan specifies. Point it at something stronger if the judge turns
# out to be too generous with its own family's output. Read only by
# `python -m eval.run`, never by the bot.
# H5: a judge from a different lab than both the persona model and the
# safety model. Empty means LLM_MODEL_CHEAP, which is the same Cydonia
# fine-tune the harness grades -- eval/run.py refuses a blocking run in
# that case (exit 3). Prices verified 2026-09-22.
LLM_MODEL_JUDGE=openai/gpt-4.1-nano

# --- 4a: the research loop (phase-4 plan section 3) ---
# Master switch. Everything in phase 4 no-ops when false. It stays
# false through milestones 4a-4c and is flipped after 4d's eval cases
# pass -- the tables, the fetcher and the commands all ship dark.
RESEARCH_ENABLED=false
# Daily quotas. A /study job is one or two search calls plus two
# distills; a /read is a single distill on a page you chose yourself.
RESEARCH_JOBS_PER_DAY=1
RESEARCH_READS_PER_DAY=3
# Per /study job.
RESEARCH_MAX_SEARCHES=4
RESEARCH_MAX_PINS=2
# Per job, and also counted against DAILY_USD_CAP. A job that hits
# either one stops and keeps the cards it already made.
RESEARCH_JOB_USD_CAP=0.10
RESEARCH_CARDS_MIN=3
RESEARCH_CARDS_MAX=6
# A pending card you never answered becomes "no" after two weeks.
RESEARCH_CARD_TTL_DAYS=14
# Adopted techniques injected per turn. These compete with retrieved
# memories for the same attention, so the number stays small.
RESEARCH_TECHNIQUES_IN_PROMPT=2
# The /study packets: comma-separated bare domains, no scheme or path.
# guides ships empty and /study guides refuses until you fill it --
# max 5 domains.
PACKET_FORUMS=reddit.com
PACKET_REF=ru.wikipedia.org,fr.wikipedia.org,en.wikipedia.org
PACKET_GUIDES=
# Fetcher limits (phase-4 plan section 5).
FETCH_TIMEOUT_S=10
FETCH_MAX_BYTES=2000000
FETCH_MAX_REDIRECTS=3
# Characters of extracted text passed to distill, ~5k tokens of Russian.
FETCH_MAX_CHARS=15000
# Honest and identifiable. Never spoofed: when a site blocks us that is
# a finding to report, not something to work around.
FETCH_USER_AGENT=AnchorBot/1.0 (personal, single-user; contact via repo owner)

# --- 5a: the Obsidian vault (phase-5 plan section 3) ---
# The kill switch: off | status | mirror | sync. 5a implements status;
# mirror and sync behave like status until 5b/5c. See docs/vault-setup.md.
VAULT_MODE=off
# The vault service on Railway's private network (or http://127.0.0.1:8080
# locally). http only, no path, no credentials in it.
VAULT_URL=http://vault.railway.internal:8080
# At least 32 random characters, the same value on the vault service.
VAULT_API_TOKEN=
# 5b: PUTs and DELETEs per sync pass (one pass a minute). Bootstrap and
# backfill are paced by this, not bursted.
VAULT_MAX_WRITES_PER_PASS=50
