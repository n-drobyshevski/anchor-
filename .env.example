# Copy to .env and fill in real values. Never commit .env.
# All values below are empty or non-secret placeholders.

MODE=polling
# polling for local dev; webhook in deployment.

TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=
# 1-256 chars, charset A-Z a-z 0-9 _ - (Telegram's webhook secret rules).

ALLOWED_CHAT_ID=
PUBLIC_URL=https://<service>.up.railway.app

DATABASE_URL=
# Railway gives postgresql://; the app rewrites it to postgresql+asyncpg:// itself.

LOG_LEVEL=INFO
PORT=8080

# --- 1c: LLM provider, prompt assembly, cost and the daily spend cap ---
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_REASONING_EFFORT=medium
XAI_PRICE_IN=2.00
XAI_PRICE_CACHED=0.50
XAI_PRICE_OUT=6.00
DAILY_USD_CAP=1.00
TZ_DEFAULT=Europe/Paris
TRANSCRIPT_TURNS=30
